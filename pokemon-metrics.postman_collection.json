{
    "info": {
        "_postman_id": "56274593-d46d-4e92-94bd-44d7a8858ed9",
        "name": "Pokemon Metrics API",
        "description": "Collection para avaliar a API de métricas de Pokémon. Antes de executar, suba os containers, rode as migrations, o seed e a ingestão. Execute `Autenticação / Login` primeiro; o token Sanctum retornado será salvo automaticamente na variável `token_pokemon` da collection.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token_pokemon}}",
                "type": "string"
            }
        ]
    },
    "event": [
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "pm.test('A resposta possui um Content-Type JSON', function () {",
                    "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                    "});"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "Autenticação",
            "description": "Fluxo de autenticação com Laravel Sanctum.",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Login realizado com sucesso', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "const response = pm.response.json();",
                                    "",
                                    "pm.test('A resposta contém um token Bearer', function () {",
                                    "    pm.expect(response.token).to.be.a('string').and.not.empty;",
                                    "    pm.expect(response.token_type).to.eql('Bearer');",
                                    "});",
                                    "",
                                    "if (response.token) {",
                                    "    pm.collectionVariables.set('token_pokemon', response.token);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\",\n    \"device_name\": \"postman\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Autentica o usuário de demonstração e salva o token retornado na variável `token_pokemon` da collection."
                    },
                    "response": []
                },
                {
                    "name": "Usuário autenticado",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Retorna o usuário autenticado', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    pm.expect(pm.response.json().data.email).to.eql(pm.collectionVariables.get('email'));",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/me",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "me"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Métricas",
            "description": "Exemplos de rankings, filtros, campos e paginação.",
            "item": [
