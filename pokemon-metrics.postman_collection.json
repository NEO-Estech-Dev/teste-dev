        {
            "name": "Encerramento",
            "description": "Execute por último para revogar o token usado na avaliação.",
            "item": [
                {
                    "name": "Logout",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Token revogado', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    pm.expect(pm.response.json().message).to.eql('Token revoked.');",
                                    "});",
                                    "",
                                    "if (pm.response.code === 200) {",
                                    "    pm.collectionVariables.unset('token_pokemon');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/logout",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "auth",
                                "logout"
                            ]
                        },
                        "description": "Revoga o token atual. Execute o login novamente antes de continuar usando endpoints protegidos."
                    },
                    "response": []
