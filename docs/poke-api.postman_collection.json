                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/metrics/pokemon",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "metrics",
                                "pokemon"
                            ]
                        },
                        "description": "Consulta sem filtros. Defaults: `metric=hp`, `field=name`, `order=desc`, `limit=10`."
                    },
                    "response": []
